{
  "name": "codeverse",
  "private": true,
  "version": "0.6.1-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "audit:phase0": "bash scripts/phase0-audit.sh",
    "test:kernel": "node scripts/kernel-smoke.cjs",
    "test:python": "python3 -m unittest discover -s tests_python -v",
    "check:kernel": "tsc -p tsconfig.kernel.json",
    "verify": "bash scripts/verify-release.sh",
    "test:syntax": "node scripts/syntax-check.cjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@react-three/fiber": "^9.1.0",
    "@uiw/react-codemirror": "^4.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
